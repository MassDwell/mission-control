    "alert_status_values": [
      "new",
      "escalated_to_steve",
      "escalated_to_clawson",
      "escalated_to_finance",
      "escalated_to_sales",
      "escalated_to_marketing",
      "acknowledged",
      "resolved"
    ],
    "severity_levels": [
      "critical",
      "high",
      "medium",
      "low"
    ],
