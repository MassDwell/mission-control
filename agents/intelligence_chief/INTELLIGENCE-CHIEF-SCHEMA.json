        "sections": {
          "massdwell": {
            "top_3_opportunities": [
              {
                "opportunity": "string",
                "potential": "string (size/scale)",
                "timeline": "string",
                "action": "string (recommended action)"
              }
            ],
            "top_3_risks": [
              {
                "risk": "string",
                "impact": "string",
                "mitigation": "string"
              }
            ]
          },
          "atlantic_laser": {},
          "alpine": {},
          "cross_business": {}
        }
      }
    ],
    "source_library": [
      {
        "id": "string (source_001, etc)",
        "name": "string (source name)",
        "type": "government | publication | forum | social | commercial_platform | internal",
        "url": "string (URL or N/A)",
        "frequency": "daily_scan | weekly_check | monthly_pull | as_needed",
        "last_checked": "ISO8601 date"
      }
    ]
  },
  "reference": {
    "research_type_values": [
      "competitor",
      "regulatory",
      "market",
      "tooling",
      "sales_intelligence",
      "macro",
