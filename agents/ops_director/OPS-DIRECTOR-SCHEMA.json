  "escalation_matrix": {
    "critical": {
      "examples": [
        "Critical supplier issue (can't source materials)",
        "Customer dissatisfaction (complaint received)",
        "Safety/quality issue (defect, safety risk)",
        "Capacity crisis (can't fulfill orders)",
        "Delivery date at risk (miss deadline)",
        "Blocker affecting multiple orders/projects"
      ],
      "escalate_to": "Steve",
      "timeframe": "Immediately"
    },
    "high": {
      "examples": [
        "Supplier delay (>2 weeks impact)",
        "Quality issue (minor defect, rework needed)",
        "Customer concern (not yet complaint)",
        "Blocker affecting single order/project",
        "Resource shortage (staff, equipment)"
      ],
      "escalate_to": "Steve or Clawson",
      "timeframe": "Within 24 hours"
    },
    "medium": {
      "examples": [
        "Minor delays (< 1 week)",
        "Expected bottlenecks",
        "Normal supply chain variations"
      ],
      "escalate_to": "Internal monitoring",
      "timeframe": "Weekly review"
    }
  },
