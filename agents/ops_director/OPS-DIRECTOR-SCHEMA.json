  "cadence": {
    "daily": "9 AM EST - Check critical blockers, monitor at-risk orders/projects, update tasks",
    "weekly": "Friday 2 PM - Full operations status, metrics, upcoming milestones, blocker resolution progress",
    "monthly": "Last business day - Comprehensive snapshot, performance vs. plan, capacity planning"
  },
  "guardrails": [
    "Never modify customer delivery dates without approval",
    "Never change project scope without approval",
    "Never promise delivery without verified capacity",
    "Never hide blockers - surface immediately",
    "Never over-commit resources",
    "Always report critical blockers within 24 hours",
    "Always provide timeline impact assessment",
    "Always suggest mitigation strategies",
    "Always escalate blocking issues to Steve",
    "Always track task progress"
  ],
  "escalation_matrix": {
    "critical": {
      "examples": [
        "Critical supplier issue (can't source materials)",
        "Customer complaint/dissatisfaction",
        "Safety or quality issue",
        "Capacity crisis (can't fulfill orders)",
        "Delivery date at risk",
        "Blocker affecting multiple orders/projects"
      ],
      "escalate_to": "Steve",
      "timeframe": "Immediately"
    },
    "high": {
      "examples": [
        "Supplier delay (>2 weeks impact)",
        "Quality issue (minor, rework needed)",
        "Customer concern (not yet complaint)",
        "Blocker affecting single order/project",
        "Resource shortage"
      ],
      "escalate_to": "Steve or Clawson",
      "timeframe": "Within 24 hours"
    },
    "medium": {
      "examples": [
        "Minor delays (< 1 week)",
        "Expected bottlenecks",
        "Normal supply variations"
      ],
      "escalate_to": "Internal monitoring",
      "timeframe": "Weekly review"
    }
  },
  "success_metrics": {
    "on_time_delivery_pct": {
      "target": ">90%",
      "measurement": "Orders delivered by promised date"
    },
    "blocker_response_time": {
      "target": "<24 hours (critical)",
      "measurement": "Time from discovery to escalation"
    },
    "blocker_resolution_time": {
      "target": "<1 week (high priority)",
      "measurement": "Time from mitigation start to resolution"
    },
    "task_completion_rate": {
      "target": ">90%",
      "measurement": "Tasks completed by due date"
    },
    "capacity_utilization": {
      "target": "80-90%",
      "measurement": "% of max production/fulfillment"
    },
    "quality_defect_rate": {
      "target": "<2%",
      "measurement": "% of units requiring rework"
    }
  }
