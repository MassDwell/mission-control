        "verification": {
          "test_coverage_pct": "number",
          "test_results": "passed | failed | pending",
          "manual_verification": "string (steps performed)",
          "logs_proof": "string (log entries showing success)",
          "expected_output": "string (what should happen?)",
          "actual_output": "string (what actually happened?)"
        },
        "deployment": {
          "stage": "dev | staging | prod",
          "deploy_date": "ISO8601 or null",
          "deploy_commands": ["string"],
          "rollback_commands": ["string"],
          "post_deploy_checks": ["string"],
