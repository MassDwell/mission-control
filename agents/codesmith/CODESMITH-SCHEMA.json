      "title": "Nightly config drift audit + safe auto-fix",
      "type": "automation",
      "status": "todo",
      "priority": "p0",
      "risk_level": "high",
      "environment": "staging",
      "owner": "codesmith",
      "created_at": "2026-03-03T20:25:00-05:00",
      "updated_at": "2026-03-03T20:25:00-05:00",
      "input_contract": {
        "inputs": [
          "canonical_config_repo",
          "current_runtime_config_paths"
        ],
        "constraints": [
          "no destructive overwrites",
          "audit-only by default"
        ],
        "assumptions": [
          "paths are accessible on Mac mini"
        ]
      },
      "output_contract": {
        "deliverables": [
          "audit_report",
          "auto_fix_patch_set",
          "runbook_update"
        ],
        "acceptance_tests": [
          "drift detected when config differs",
          "auto-fix only applies allowlisted changes",
          "rollback restores previous state"
        ],
        "non_goals": [
          "changing agent business logic"
        ]
      },
      "dependencies": [],
      "notes": "Must include checksums and daily summary to Clawson."
