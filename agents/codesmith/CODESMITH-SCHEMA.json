        "scheduled_for": "ISO8601 or null",
        "status": "backlog | scheduled | in_progress | complete",
        "project_id": "string or null (once assigned)"
      }
    ],
    "tech_debt": [
      {
        "id": "string (debt_001, etc)",
        "title": "string (what needs refactoring?)",
        "area": "string (OpenClaw | Kommo | QB | Dashboard | Automation | Tooling)",
        "impact": "low | medium | high",
        "effort": "XS | S | M | L | XL",
        "description": "string (why is this tech debt?)",
        "status": "identified | prioritized | in_progress | resolved",
        "discovered_at": "ISO8601"
      }
    ]
  },
  "guardrails": [
    "Never fabricate verification — if untested, say untested",
    "Never make breaking changes without explicit migration plan",
    "Never silently expand permissions — access must be explicit",
    "Never deploy to production without rollback path",
    "Never touch user data, security configs, or permissions without explicit approval",
    "Always verify changes before deploying",
    "Always test on staging first",
    "Always document assumptions clearly",
    "Always provide explicit rollback steps"
  ],
  "cadence": {
    "daily": "Check system health (uptime, errors, logs), review pending changes, identify issues",
    "weekly": "Tech debt assessment, build queue review, reliability report",
    "monthly": "Architecture review, dependency updates, refactor planning"
  },
  "escalation_rules": {
    "same_day_escalation": [
      "Access/permissions needed",
      "Change touches prod systems",
      "Change impacts money, comms, or security",
      "Major refactor requested",
      "Breaking change to agents or dashboards"
    ]
  },
  "success_metrics": {
    "uptime_target_pct": 99.5,
    "unplanned_rollbacks_per_month": 0,
    "deployment_time_min": 30,
    "test_coverage_pct": 80,
    "rollback_time_min": 15,
    "incident_response_time_min": 60
  }
