  "runbooks": [
    {
      "id": "rb_001",
      "system": "openclaw_gateway",
      "title": "Gmail Token Refresh Failure Response",
      "purpose": "Step-by-step recovery when token refresh fails",
      "steps": [
        "Check logs: tail -f credentials/google/refresh-tokens.log",
        "Identify which account failed (steve, sales, atlantic)",
        "If OAuth issue: run manual re-auth via Google OAuth flow",
        "If transient network: wait 5 min, cron will retry automatically",
        "If persistent: alert Steve and disable affected email bot temporarily"
      ],
      "known_failure_modes": [
        "Refresh token expired (re-auth required)",
        "Network timeout (auto-retry succeeds)",
        "OAuth scope revoked (requires manual re-auth)",
        "Invalid credentials (update creds, re-auth)"
      ],
      "rollback_steps": [
        "Revert to previous token state (backup every refresh)",
        "Restart cron job",
        "Verify tokens valid with test API call"
      ],
      "last_updated_at": "2026-02-25T10:00:00-05:00"
    },
    {
      "id": "rb_002",
      "system": "kommo",
      "title": "MassDwell Kommo CRM Integration Troubleshooting",
      "purpose": "Diagnose and fix Kommo API connectivity issues",
      "steps": [
        "Verify Kommo API key is valid: curl -H 'Authorization: Bearer <key>' https://api.kommo.com/api/account",
        "Check lead sync status: Review kommo-sync.log for recent errors",
        "If sync failed: Run manual sync script to reload leads",
        "If API rate limit hit: Wait 60 sec, retry (rate limit resets)",
        "If permission denied: Verify CRM access level for auth user"
      ],
      "known_failure_modes": [
        "API key expired (get fresh key from Kommo admin)",
        "Rate limit (backoff and retry)",
        "Network timeout (usually transient)",
        "Lead field mismatch (schema update needed)"
      ],
      "rollback_steps": [
        "Stop all Kommo write operations",
        "Restore from last valid lead backup",
        "Verify lead counts match before resuming"
      ],
      "last_updated_at": "2026-02-20T14:00:00-05:00"
    },
    {
      "id": "rb_003",
      "system": "email_bots",
      "title": "Email Bot Delivery Failure Response",
      "purpose": "Recover from email delivery errors across all bots",
      "steps": [
        "Check SMTP connection: telnet mail.massdwell.com 587",
        "Review delivery logs: tail -f logs/email-delivery.log",
        "If SMTP timeout: Check network connectivity, retry in 5 min",
        "If 550 (unknown recipient): Validate email list against CRM",
        "If 451 (try again later): Exponential backoff, re-queue emails"
      ],
      "known_failure_modes": [
        "SMTP auth failure (verify credentials)",
        "Rate limit from ISP (slow down send rate)",
        "Recipient blacklist (remove from list)",
        "SPF/DKIM validation failure (check email headers)"
      ],
      "rollback_steps": [
        "Pause email bot",
        "Investigate root cause",
        "Fix issue (re-auth, DNS update, etc.)",
        "Resume with manual re-send of failed emails"
      ],
      "last_updated_at": "2026-02-28T10:00:00-05:00"
    }
  ],
